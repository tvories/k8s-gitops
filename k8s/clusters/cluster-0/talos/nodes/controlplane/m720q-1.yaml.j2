---
# m720q-1 — control plane, 192.168.80.99. Lenovo m720q: enp1s0 is the PCIe 10G
# NIC (carries everything), eno1 the unused onboard 1G (no address).
machine:
  install:
    disk: /dev/sda
  network:
    # eno1: unused onboard NIC. May be cabled for PXE/netboot.xyz re-imaging,
    # which runs in firmware and ignores this. MTU 9000 matches m720q-4's eno1
    # so Ceph's CephNodeInconsistentMTU alert (per device name) stays quiet.
    interfaces:
      - interface: eno1
        dhcp: false
        mtu: 9000
      # No address on the untagged LAN (see the networking note below).
      # Omitting the DHCPv4Config is NOT enough: Talos then falls back to its
      # platform-default DHCP at metric 1024, which beats vlan80's 2048.
      - interface: enp1s0
        dhcp: false
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: m720q-1.mcbadass.local
# --- Networking. ROUTE METRICS ARE LOAD-BEARING (lower wins):
#     2048  vlan80  (192.168.80.1)  <- preferred default route
#     4096  vlan50  (192.168.50.1)
# Talos's default DHCP metric is 1024, which would beat vlan80 — so every one
# is set explicitly.
#
# The untagged parent (LAN, 192.168.1.0/24) deliberately has NO address
# (removed 2026-10-30). A LAN leg made every LAN host on-link: replies to LAN
# clients bypassed the router (asymmetric routing -> uploads to LB VIPs stalled
# at ~64KB) and traffic to homebox left from a LAN IP its firewall didn't
# expect. The parent link stays up for multus-legacy macvlan pods (echomuse),
# which carry their own LAN IPs.
---
apiVersion: v1alpha1
kind: LinkConfig
name: enp1s0
mtu: 9000
---
apiVersion: v1alpha1
kind: VLANConfig
name: enp1s0.80
vlanID: 80
parent: enp1s0
mtu: 9000
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: enp1s0.80
routeMetric: 2048
---
# Control-plane VIP. Lives on the vlan80 sub-interface, not the parent link.
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 192.168.80.200
link: enp1s0.80
---
# IoT VLAN, required on every node: the multus-iot NAD uses master enp1s0.50
# (home-assistant 192.168.50.10, echomuse 192.168.50.35). Not jumbo-framed.
apiVersion: v1alpha1
kind: VLANConfig
name: enp1s0.50
vlanID: 50
parent: enp1s0
mtu: 1500
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: enp1s0.50
routeMetric: 4096
